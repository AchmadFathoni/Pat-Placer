{
  "manifest_version": 3,
  "name": "PatPlacer OpenSource",
  "version": "1.0.0",
  "description": "Standalone PatPlacer extension for wplace.live (no online activation).",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://wplace.live/*",
    "https://*.wplace.live/*",
    "https://backend.wplace.live/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PatPlacer OpenSource",
    "default_icon": {
      "16": "icons/anchor.png",
      "48": "icons/anchor.png",
      "128": "icons/anchor.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://wplace.live/*",
        "https://*.wplace.live/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/anchor.png",
    "48": "icons/anchor.png",
    "128": "icons/anchor.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/*.js",
        "styles/*.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
